---
import Base from '../../layouts/Base.astro';
import Countdown from '../../components/Countdown.astro';
import PathPreview from '../../components/PathPreview.astro';
import CityTable from '../../components/CityTable.astro';
import SafetyNotice from '../../components/SafetyNotice.astro';
import { LANGS, href, type Lang } from '../../i18n/config.ts';
import { t } from '../../i18n/ui.ts';
import { cityById, citiesWithEclipse, tunisiaFacts } from '../../lib/data.ts';
import { formatDuration, formatTime } from '../../lib/format.ts';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const d = t(lang);
const facts = tunisiaFacts();
const sfax = cityById('sfax');
const tMax = formatDuration(facts.maxDuration, lang);
const arrow = lang === 'ar' ? '←' : '→';
const towns = citiesWithEclipse();
const firstC1 = new Date(Math.min(...towns.map((c) => c.eclipse.c1!.time.getTime())));
const lastC4 = new Date(Math.max(...towns.map((c) => c.eclipse.c4!.time.getTime())));
const window = `${formatTime(facts.firstC2, lang).slice(0, 5)}–${formatTime(facts.lastC3, lang).slice(0, 5)}`;

const C = {
  en: {
    title: 'Total solar eclipse of 2 August 2027 in Tunisia',
    description: `Everything about the total solar eclipse of 2 August 2027 in Tunisia: interactive map of the path, local times for every town, up to ${tMax} of totality, safety guide and destinations.`,
    h1: 'Total solar eclipse in Tunisia',
    intro: `On Monday 2 August 2027, in the middle of the morning, the Moon will completely hide the Sun over a band about 250 km wide crossing central and southern Tunisia. Inside this band, day will turn into twilight for up to ${tMax}.`,
    whatTitle: 'What will happen?',
    what: [
      'For about two and a half hours, the Moon passes in front of the Sun: this is the partial eclipse, visible from the whole of Tunisia.',
      'Inside the path of totality, the Sun is completely hidden for a few minutes: the sky darkens, the brightest stars and planets appear and the solar corona becomes visible.',
      'Outside the path — in Tunis, Sousse, Monastir or Bizerte — the eclipse remains partial: the Sun never disappears completely.',
    ],
    facts: [
      ['Date', 'Monday 2 August 2027'],
      ['Totality in Tunisia', `between ${window} (Tunisian time)`],
      ['Longest totality in Tunisia', `${tMax}, on the central line`],
      ['In Sfax', `${formatDuration(sfax.eclipse.centralDuration!, lang)} from ${formatTime(sfax.eclipse.c2!.time, lang)}`],
      ['Sun height', `about ${Math.round(facts.sunAltitude[0])}–${Math.round(facts.sunAltitude[1])}° above the horizon`],
    ],
    regionsTitle: 'Where can totality be seen?',
    regions: 'The path of totality covers in particular Sfax, Sidi Bouzid, Gafsa, Kasserine, Gabès, Djerba, El Jem, Mahdia and Kairouan. Durations are longest near the central line and decrease quickly towards the limits.',
    regionsTable: 'Towns with the longest totality',
    allTowns: 'See all towns on the interactive map',
    prepareTitle: 'Prepare your observation',
    cards: [
      ['guide', 'Observation guide', 'Phases of the eclipse, eye safety, equipment and photography.'],
      ['destinations', 'Destinations', 'Where to go in Tunisia, with computed times for each site.'],
      ['weather', 'Weather & climate', 'What climate statistics say about clear skies on an August morning.'],
      ['science', 'Understand the eclipse', 'Why it happens, why the path is narrow and why durations vary.'],
    ],
  },
  fr: {
    title: 'Éclipse solaire totale du 2 août 2027 en Tunisie',
    description: `Tout sur l’éclipse solaire totale du 2 août 2027 en Tunisie : carte interactive de la trajectoire, horaires pour chaque ville, jusqu’à ${tMax} de totalité, guide de sécurité et destinations.`,
    h1: 'Éclipse totale de Soleil en Tunisie',
    intro: `Le lundi 2 août 2027, en milieu de matinée, la Lune masquera entièrement le Soleil dans une bande d’environ 250 km de large qui traverse le centre et le sud de la Tunisie. Dans cette bande, le jour laissera place à un crépuscule pendant jusqu’à ${tMax}.`,
    whatTitle: 'Que va-t-il se passer ?',
    what: [
      'Pendant environ deux heures et demie, la Lune passe devant le Soleil : c’est l’éclipse partielle, visible depuis toute la Tunisie.',
      'Dans la bande de totalité, le Soleil est entièrement caché pendant quelques minutes : le ciel s’assombrit, les étoiles et planètes les plus brillantes apparaissent et la couronne solaire devient visible.',
      'En dehors de la bande — à Tunis, Sousse, Monastir ou Bizerte — l’éclipse reste partielle : le Soleil ne disparaît jamais complètement.',
    ],
    facts: [
      ['Date', 'Lundi 2 août 2027'],
      ['Totalité en Tunisie', `entre ${window} (heure tunisienne)`],
      ['Plus longue totalité en Tunisie', `${tMax}, sur la ligne centrale`],
      ['À Sfax', `${formatDuration(sfax.eclipse.centralDuration!, lang)} à partir de ${formatTime(sfax.eclipse.c2!.time, lang)}`],
      ['Hauteur du Soleil', `environ ${Math.round(facts.sunAltitude[0])} à ${Math.round(facts.sunAltitude[1])}° au-dessus de l’horizon`],
    ],
    regionsTitle: 'Où voir la totalité ?',
    regions: 'La bande de totalité couvre notamment Sfax, Sidi Bouzid, Gafsa, Kasserine, Gabès, Djerba, El Jem, Mahdia et Kairouan. Les durées sont les plus longues près de la ligne centrale et diminuent rapidement vers les limites.',
    regionsTable: 'Villes bénéficiant de la plus longue totalité',
    allTowns: 'Voir toutes les villes sur la carte interactive',
    prepareTitle: 'Préparer votre observation',
    cards: [
      ['guide', 'Guide d’observation', 'Phases de l’éclipse, sécurité des yeux, matériel et photographie.'],
      ['destinations', 'Destinations', 'Où aller en Tunisie, avec les horaires calculés pour chaque site.'],
      ['weather', 'Météo et climat', 'Ce que disent les statistiques climatiques sur le ciel d’un matin d’août.'],
      ['science', 'Comprendre l’éclipse', 'Pourquoi elle se produit, pourquoi la bande est étroite et pourquoi la durée varie.'],
    ],
  },
  ar: {
    title: 'الكسوف الكلي للشمس يوم 2 أوت 2027 في تونس',
    description: `كل ما يتعلق بالكسوف الكلي للشمس يوم 2 أوت 2027 في تونس: خريطة تفاعلية للمسار، مواقيت كل مدينة، كسوف كلي يصل إلى ${tMax}، دليل السلامة والوجهات.`,
    h1: 'كسوف كلي للشمس في تونس',
    intro: `يوم الاثنين 2 أوت 2027، في منتصف الصباح، سيحجب القمر الشمس بالكامل في نطاق يبلغ عرضه حوالي 250 كم يعبر وسط تونس وجنوبها. داخل هذا النطاق سيتحول النهار إلى ما يشبه الغسق لمدة تصل إلى ${tMax}.`,
    whatTitle: 'ماذا سيحدث؟',
    what: [
      'لمدة ساعتين ونصف تقريبًا يمر القمر أمام الشمس: إنه الكسوف الجزئي، المرئي من كامل التراب التونسي.',
      'داخل نطاق الكسوف الكلي تُحجب الشمس تمامًا لبضع دقائق: تُظلم السماء وتظهر ألمع النجوم والكواكب وتصبح الهالة الشمسية مرئية.',
      'خارج النطاق، في تونس العاصمة وسوسة والمنستير وبنزرت، يبقى الكسوف جزئيًا ولا تختفي الشمس كليًا أبدًا.',
    ],
    facts: [
      ['التاريخ', 'الاثنين 2 أوت 2027'],
      ['الكسوف الكلي في تونس', `بين ${window} (بتوقيت تونس)`],
      ['أطول كسوف كلي في تونس', `${tMax} على الخط المركزي`],
      ['في صفاقس', `${formatDuration(sfax.eclipse.centralDuration!, lang)} بداية من ${formatTime(sfax.eclipse.c2!.time, lang)}`],
      ['ارتفاع الشمس', `حوالي ${Math.round(facts.sunAltitude[0])} إلى ${Math.round(facts.sunAltitude[1])} درجة فوق الأفق`],
    ],
    regionsTitle: 'أين يمكن مشاهدة الكسوف الكلي؟',
    regions: 'يشمل نطاق الكسوف الكلي خاصة صفاقس وسيدي بوزيد وقفصة والقصرين وقابس وجربة والجم والمهدية والقيروان. تكون المدة أطول قرب الخط المركزي وتتناقص بسرعة كلما اقتربنا من الحدود.',
    regionsTable: 'المدن التي تحظى بأطول كسوف كلي',
    allTowns: 'شاهد كل المدن على الخريطة التفاعلية',
    prepareTitle: 'استعد للرصد',
    cards: [
      ['guide', 'دليل الرصد', 'مراحل الكسوف، سلامة العينين، المعدات والتصوير.'],
      ['destinations', 'الوجهات', 'إلى أين تذهب في تونس، مع المواقيت المحسوبة لكل موقع.'],
      ['weather', 'الطقس والمناخ', 'ما تقوله الإحصائيات المناخية عن صفاء السماء في صباح من شهر أوت.'],
      ['science', 'فهم الكسوف', 'لماذا يحدث، ولماذا النطاق ضيق، ولماذا تختلف المدة من مكان لآخر.'],
    ],
  },
}[lang];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: d.site.name,
    url: new URL(href(lang), Astro.site).toString(),
    inLanguage: lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Event',
    name: C.title,
    description: C.description,
    startDate: firstC1.toISOString(),
    endDate: lastC4.toISOString(),
    eventStatus: 'https://schema.org/EventScheduled',
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    isAccessibleForFree: true,
    location: { '@type': 'Place', name: 'Tunisia', address: { '@type': 'PostalAddress', addressCountry: 'TN' } },
    image: new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/og/og-${lang}.jpg`, Astro.site).toString(),
    organizer: { '@type': 'Organization', name: 'Eclipse in Tunisia 2027', url: new URL(href(lang), Astro.site).toString() },
  },
];
---

<Base lang={lang} path="" title={C.title} description={C.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="sky" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-text">
        <p class="eyebrow">{d.site.date}</p>
        <h1>{C.h1}</h1>
        <p class="tagline ltr" lang="en">{d.site.tagline}</p>
        <p class="lead">{C.intro}</p>
        <Countdown lang={lang} target={sfax.eclipse.c2!.time.toISOString()} />
        <div class="ctas">
          <a class="btn btn-primary" href={href(lang, 'map')}>{d.common.openMap}</a>
          <a class="btn" href={href(lang, 'calculator')}>{d.common.openCalculator}</a>
        </div>
      </div>
      <div class="hero-visual" aria-hidden="true">
        <div class="corona"></div>
        <div class="moon"></div>
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="grid grid-2 align">
      <div>
        <h2>{C.whatTitle}</h2>
        <ul class="steps">
          {C.what.map((p) => <li>{p}</li>)}
        </ul>
        <dl class="facts">
          {C.facts.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
      </div>
      <PathPreview lang={lang} />
    </div>
    <SafetyNotice lang={lang} />
  </section>

  <section class="container section band">
    <h2>{C.regionsTitle}</h2>
    <p class="lead">{C.regions}</p>
    <h3>{C.regionsTable}</h3>
    <CityTable lang={lang} limit={10} caption={C.regionsTable} />
    <p><a href={href(lang, 'map')}>{C.allTowns} {arrow}</a></p>
  </section>

  <section class="container section">
    <h2>{C.prepareTitle}</h2>
    <div class="grid grid-3 cards">
      {C.cards.map(([p, title, text]) => (
        <a class="card link-card" href={href(lang, p)}>
          <h3>{title}</h3>
          <p>{text}</p>
          <span class="more" aria-hidden="true">{d.common.readMore} {arrow}</span>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 75% 40%, rgba(247, 183, 59, 0.1), transparent 50%),
      radial-gradient(ellipse at 20% 0%, rgba(165, 151, 255, 0.18), transparent 55%),
      linear-gradient(180deg, var(--space) 0%, var(--night) 100%);
    border-bottom: 1px solid var(--line);
  }
  .sky {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(1px 1px at 12% 22%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 34% 8%, #cfd8ff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 58% 30%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 82% 12%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 92% 64%, #cfd8ff 50%, transparent 51%),
      radial-gradient(1px 1px at 6% 72%, #fff 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 44% 86%, #fff 50%, transparent 51%),
      radial-gradient(1px 1px at 70% 92%, #cfd8ff 50%, transparent 51%);
    opacity: 0.7;
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 32px;
    align-items: center;
    padding-block: clamp(40px, 8vw, 96px);
  }
  .tagline {
    font-size: 1.15rem;
    color: var(--sun-soft);
    font-weight: 600;
    margin-top: -0.3em;
    letter-spacing: 0.04em;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }
  .hero-visual {
    position: relative;
    aspect-ratio: 1;
    width: min(100%, 420px);
    justify-self: center;
  }
  .corona {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background:
      radial-gradient(circle, rgba(255, 246, 220, 0.95) 38%, rgba(247, 183, 59, 0.45) 45%, rgba(165, 151, 255, 0.18) 60%, transparent 71%);
    filter: blur(2px);
    animation: breathe 8s ease-in-out infinite;
  }
  .moon {
    position: absolute;
    inset: 24%;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #0d1124, #020309 70%);
    box-shadow: 0 0 0 1.5px rgba(255, 246, 220, 0.85), 0 0 60px rgba(255, 246, 220, 0.5);
  }
  @keyframes breathe {
    50% {
      transform: scale(1.04);
      opacity: 0.85;
    }
  }
  .steps li {
    margin-block: 0.6em;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 12px;
    margin: 24px 0 0;
  }
  .facts div {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
  }
  .facts dt {
    font-size: 0.82rem;
    color: var(--muted);
    font-weight: 600;
  }
  .facts dd {
    margin: 2px 0 0;
    font-weight: 700;
  }
  .align {
    align-items: start;
  }
  .link-card {
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }
  .link-card:hover {
    border-color: var(--turquoise);
    transform: translateY(-2px);
  }
  .link-card h3 {
    margin-top: 0;
  }
  .link-card p {
    color: var(--muted);
  }
  .more {
    color: var(--turquoise);
    font-weight: 650;
  }
  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    .hero-visual {
      width: min(60%, 260px);
      grid-row: 1;
    }
  }
</style>
