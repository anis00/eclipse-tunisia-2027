---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LANGS, LANG_META, asset, href, type Lang } from '../i18n/config.ts';
import { t } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
  /** Path without language prefix, e.g. "map" or "destinations/sfax" */
  path: string;
  title: string;
  description: string;
  /** Path of the social image relative to the site root */
  image?: string;
  imageAlt?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  /** Langs in which this page exists (defaults to all) */
  alternates?: readonly Lang[];
  type?: 'website' | 'article';
}

const {
  lang,
  path,
  title,
  description,
  image = `og/og-${lang}.jpg`,
  imageAlt,
  jsonLd,
  noindex = false,
  alternates = LANGS,
  type = 'website',
} = Astro.props;
const d = t(lang);
const meta = LANG_META[lang];
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).toString();
const canonical = abs(href(lang, path));
const fullTitle = path === '' ? `${d.site.name} — ${d.site.tagline}` : `${title} | ${d.site.name}`;
const imageUrl = abs(asset(image));
const ldList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const gsc = import.meta.env.PUBLIC_GSC_VERIFICATION;
const analyticsDomain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN;
const analyticsSrc = import.meta.env.PUBLIC_ANALYTICS_SRC;
---

<!doctype html>
<html lang={lang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {alternates.map((l) => <link rel="alternate" hreflang={l} href={abs(href(l, path))} />)}
    {alternates.includes('en') && <link rel="alternate" hreflang="x-default" href={abs(href('en', path))} />}

    <meta name="theme-color" content="#0a1028" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={d.site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt ?? d.site.name} />
    <meta property="og:locale" content={meta.ogLocale} />
    {LANGS.filter((l) => l !== lang && alternates.includes(l)).map((l) => <meta property="og:locale:alternate" content={LANG_META[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {gsc && <meta name="google-site-verification" content={gsc} />}
    {analyticsDomain && analyticsSrc && <script defer data-domain={analyticsDomain} src={analyticsSrc}></script>}
    {ldList.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{d.site.skip}</a>
    <Header lang={lang} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
