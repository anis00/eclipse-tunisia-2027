---
import { citiesWithEclipse } from '../lib/data.ts';
import { t } from '../i18n/ui.ts';
import { LANG_META, type Lang } from '../i18n/config.ts';
interface Props {
  lang: Lang;
  idPrefix?: string;
}
const { lang, idPrefix = 'calc' } = Astro.props;
const d = t(lang);
const collator = new Intl.Collator(LANG_META[lang].locale);
const options = [...citiesWithEclipse()].sort((a, b) => collator.compare(a.name[lang], b.name[lang]));
---

<form class="calc-form" novalidate data-calc-form>
  <div class="field">
    <label for={`${idPrefix}-city`}>{d.calc.chooseCity}</label>
    <select id={`${idPrefix}-city`} name="city" data-city>
      <option value="">{d.calc.cityPlaceholder}</option>
      {options.map((c) => (
        <option value={c.id} data-lat={c.lat} data-lon={c.lon}>
          {c.name[lang]}
        </option>
      ))}
    </select>
  </div>
  <div class="coords">
    <div class="field">
      <label for={`${idPrefix}-lat`}>{d.calc.lat}</label>
      <input id={`${idPrefix}-lat`} name="lat" inputmode="decimal" autocomplete="off" dir="ltr" data-lat aria-describedby={`${idPrefix}-hint ${idPrefix}-lat-err`} />
      <p class="field-error" id={`${idPrefix}-lat-err`} data-lat-err></p>
    </div>
    <div class="field">
      <label for={`${idPrefix}-lon`}>{d.calc.lon}</label>
      <input id={`${idPrefix}-lon`} name="lon" inputmode="decimal" autocomplete="off" dir="ltr" data-lon aria-describedby={`${idPrefix}-hint ${idPrefix}-lon-err`} />
      <p class="field-error" id={`${idPrefix}-lon-err`} data-lon-err></p>
    </div>
  </div>
  <p class="field-hint" id={`${idPrefix}-hint`}>{d.calc.coordsHint}</p>
  <div class="actions">
    <button type="submit" class="btn btn-primary">{d.calc.compute}</button>
    <button type="button" class="btn" data-locate>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 2v4M12 18v4M2 12h4M18 12h4" stroke="currentColor" stroke-width="2"></path></svg>
      <span>{d.calc.locate}</span>
    </button>
  </div>
  <p class="field-hint">{d.calc.locateHint}</p>
  <p class="field-error" role="alert" data-geo-err></p>
</form>

<style>
  .calc-form .field {
    margin-bottom: 12px;
  }
  .coords {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .coords .field {
    margin-bottom: 0;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
  }
  .field-error:empty {
    display: none;
  }
</style>
