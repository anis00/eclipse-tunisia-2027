---
/**
 * Static SVG map of Tunisia with the path of totality, rendered at build time.
 * Works without JavaScript and links to the interactive map.
 */
import { makeProjection, pathData, readGeoJSON } from '../lib/svgmap.ts';
import { citiesWithEclipse } from '../lib/data.ts';
import { href, type Lang } from '../i18n/config.ts';
import { t } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const proj = makeProjection([6.9, 30.1, 12.2, 37.6], 560);
const countries = readGeoJSON('region-countries.geojson').features;
const govs = readGeoJSON('tunisia-governorates.geojson').features;
const path = readGeoJSON('eclipse-2027-path.geojson').features;
const umbra = path.find((f) => f.properties.kind === 'umbra')!;
const central = path.find((f) => f.properties.kind === 'central')!;
const labelIds = ['tunis', 'sousse', 'kairouan', 'sfax', 'gafsa', 'gabes', 'houmt-souk', 'tozeur', 'sidi-bouzid', 'tataouine', 'bizerte', 'el-kef'];
const towns = citiesWithEclipse().filter((c) => labelIds.includes(c.id));
const rtl = lang === 'ar';
---

<figure class="preview">
  <a href={href(lang, 'map')} class="map-link">
    <span class="visually-hidden">{d.common.openMap}</span>
    <svg viewBox={`0 0 ${proj.width} ${proj.height}`} aria-hidden="true">
      <defs>
        <clipPath id="pp-clip"><rect width={proj.width} height={proj.height}></rect></clipPath>
        <linearGradient id="pp-umbra" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0" stop-color="#a597ff" stop-opacity="0.42"></stop>
          <stop offset="0.5" stop-color="#5fd4d9" stop-opacity="0.32"></stop>
          <stop offset="1" stop-color="#a597ff" stop-opacity="0.42"></stop>
        </linearGradient>
      </defs>
      <rect width={proj.width} height={proj.height} fill="#071530"></rect>
      <g clip-path="url(#pp-clip)">
        {countries.map((f) => (
          <path d={pathData(proj, f.geometry)} fill={f.properties.iso === 'TUN' ? 'none' : '#151d3a'} stroke="#2c3866" stroke-width="1"></path>
        ))}
        {govs.map((f) => (
          <path d={pathData(proj, f.geometry)} fill="#1c2750" stroke="#3a4a85" stroke-width="0.7"></path>
        ))}
        <path d={pathData(proj, umbra.geometry)} fill="url(#pp-umbra)" stroke="#d9d3ff" stroke-width="1.4" stroke-dasharray="5 4"></path>
        <path d={pathData(proj, central.geometry)} fill="none" stroke="#f7b73b" stroke-width="2"></path>
        {towns.map((c) => {
          const [x, y] = proj.project(c.lon, c.lat);
          const total = c.eclipse.kind === 'total';
          return (
            <g>
              <circle cx={x} cy={y} r={total ? 4.5 : 3.5} fill={total ? '#f7b73b' : '#f5f2ea'} stroke="#05060d" stroke-width="1.5"></circle>
              <text
                x={rtl ? x - 8 : x + 8}
                y={y + 4.5}
                text-anchor={rtl ? 'end' : 'start'}
                fill="#f5f2ea"
                font-size="14"
                font-weight="600"
                paint-order="stroke"
                stroke="#071530"
                stroke-width="3.5"
              >
                {c.name[lang]}
              </text>
            </g>
          );
        })}
      </g>
    </svg>
  </a>
  <figcaption>
    <span class="key"><span class="sw umbra"></span>{d.map.umbra}</span>
    <span class="key"><span class="sw central"></span>{d.map.central}</span>
    <span class="key"><span class="sw dot-total"></span>{d.common.total}</span>
    <span class="key"><span class="sw dot-partial"></span>{d.common.partial}</span>
  </figcaption>
</figure>

<style>
  .preview {
    margin: 0;
  }
  .map-link {
    display: block;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    transition: border-color 0.2s;
  }
  .map-link:hover {
    border-color: var(--turquoise);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-top: 10px;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .sw {
    display: inline-block;
    width: 22px;
    height: 12px;
    border-radius: 3px;
  }
  .umbra {
    background: rgba(140, 170, 240, 0.45);
    border: 1px dashed #d9d3ff;
  }
  .central {
    height: 3px;
    background: var(--sun);
  }
  .dot-total,
  .dot-partial {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--sun);
  }
  .dot-partial {
    background: var(--ink);
  }
</style>
