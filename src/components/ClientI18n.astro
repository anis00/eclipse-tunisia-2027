---
import { LANG_META, type Lang } from '../i18n/config.ts';
import { t } from '../i18n/ui.ts';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const payload = {
  lang,
  locale: LANG_META[lang].locale,
  d: { calc: d.calc, common: d.common, sim: d.sim, map: d.map },
  base: import.meta.env.BASE_URL,
};
---

<script id="client-i18n" type="application/json" set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />
