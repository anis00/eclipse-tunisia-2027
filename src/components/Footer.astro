---
import Logo from './Logo.astro';
import { href, type Lang } from '../i18n/config.ts';
import { t } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const cols = [
  [
    ['map', d.nav.map],
    ['calculator', d.nav.calculator],
    ['destinations', d.nav.destinations],
    ['weather', d.nav.weather],
  ],
  [
    ['guide', d.nav.guide],
    ['science', d.nav.science],
    ['faq', d.nav.faq],
    ['news', d.nav.news],
  ],
  [
    ['sources', d.nav.sources],
    ['about', d.nav.about],
    ['privacy', d.nav.privacy],
    ['legal', d.nav.legal],
  ],
] as const;
---

<footer class="site-footer">
  <div class="container inner">
    <div class="about">
      <a class="brand" href={href(lang)}><Logo size={34} /><span class="ltr">ECLIPSE 2027 — TUNISIA</span></a>
      <p>{d.footer.about}</p>
      <p class="credit">{d.footer.credit}</p>
    </div>
    {cols.map((col) => (
      <ul>
        {col.map(([p, label]) => (
          <li><a href={href(lang, p)}>{label}</a></li>
        ))}
      </ul>
    ))}
  </div>
  <div class="container bottom">
    <p>{d.footer.rights}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 64px;
    border-top: 1px solid var(--line);
    background: var(--space);
    color: var(--muted);
    font-size: 0.95rem;
  }
  .inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 28px;
    padding-block: 40px 24px;
  }
  .brand {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    color: var(--ink);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-decoration: none;
    margin-bottom: 12px;
  }
  .credit {
    color: var(--faint);
    font-size: 0.88rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li a {
    color: var(--muted);
    text-decoration: none;
    display: inline-block;
    padding: 4px 0;
  }
  li a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .bottom {
    border-top: 1px solid var(--line);
    padding-block: 16px 28px;
    font-size: 0.85rem;
    color: var(--faint);
  }
  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
