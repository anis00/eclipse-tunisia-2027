---
import { href, type Lang } from '../i18n/config.ts';
import { t } from '../i18n/ui.ts';
interface Props {
  lang: Lang;
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
const d = t(lang);
---

<aside class="notice notice-danger safety" aria-label={d.safety.title}>
  <p><strong>⚠ {d.safety.title}.</strong> {d.safety.short}</p>
  {!compact && <p><a href={href(lang, 'guide') + '#safety'}>{d.safety.cta}</a></p>}
</aside>
