# Public origin of the site (no trailing slash). Used for canonical URLs, hreflang and sitemap.
SITE_URL=https://eclipseintunisia.com
# Sub-path when the site is served from a folder (GitHub Pages project site), e.g. /eclipse-tunisia-2027
BASE_PATH=/
# Optional: privacy-friendly analytics (Plausible-compatible). Leave empty to disable.
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SRC=
# Optional: Google Search Console verification token (content of the meta tag).
PUBLIC_GSC_VERIFICATION=
